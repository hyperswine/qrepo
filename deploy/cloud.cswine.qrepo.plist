<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ~/Library/LaunchAgents/cloud.cswine.qrepo.plist on the mini.
     The repository at /Users/jq/qrepo-docs is the canonical store: init it
     and run `qr serve-token` there first.  It listens on the tailnet address
     only; if tailscale is not up yet at login the bind fails and launchd
     starts it again. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>cloud.cswine.qrepo</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jq/qrepo/qr</string>
    <string>--root</string><string>/Users/jq/qrepo-docs</string>
    <string>serve</string><string>7600</string>
    <string>--address</string><string>100.107.153.43</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/jq/qrepo/qrepo.out</string>
  <key>StandardErrorPath</key><string>/Users/jq/qrepo/qrepo.out</string>
</dict>
</plist>
